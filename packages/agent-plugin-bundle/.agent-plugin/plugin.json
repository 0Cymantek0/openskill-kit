{
  "schemaVersion": "openskill-kit.agent-plugin.v1",
  "name": "openskill-kit",
  "version": "0.1.0",
  "displayName": "OpenSkillKit",
  "description": "Local-first behavior memory, skill evolution, and MCP bridge for existing coding harnesses.",
  "compatibility": [
    "agent-plugin",
    "mcp-stdio",
    "codex",
    "claude-code",
    "agents-md",
    "opencode"
  ],
  "capabilities": [
    "skill-drafting",
    "skill-audit",
    "skill-evaluation",
    "project-behavior-retrieval",
    "local-mcp-tools",
    "explicit-install-receipts",
    "openworld-review-promotion"
  ],
  "skills": [
    {
      "path": "skills/openskill-kit"
    }
  ],
  "mcp": {
    "config": ".mcp.json",
    "server": "openskill-kit-mcp",
    "transport": "stdio"
  },
  "installGuides": {
    "directory": "install-guides",
    "hosts": {
      "opencode": "install-guides/opencode.md",
      "codex": "install-guides/codex.md",
      "claude-code": "install-guides/claude-code.md",
      "cursor": "install-guides/cursor.md",
      "generic-mcp": "install-guides/generic-mcp.md"
    }
  },
  "installProfile": {
    "schemaVersion": "openskill-kit.agent-plugin-install-profile.v1",
    "mode": "local-project-plugin",
    "pluginDirectory": "packages/agent-plugin-bundle",
    "firstCall": {
      "mcpTool": "osk_get_status",
      "cliFallback": "openskill-kit status --json"
    },
    "mcp": {
      "serverName": "openskill-kit",
      "command": "openskill-kit-mcp",
      "transport": "stdio",
      "workingDirectory": ".",
      "requiredEnv": {
        "OPENSKILLKIT_PROJECT_ROOT": "<absolute project root>"
      },
      "configFile": ".mcp.json",
      "descriptors": "mcp/descriptors.json",
      "descriptorHashes": "mcp/descriptor-hashes.json"
    },
    "commandRouting": {
      "map": "commands/commands.json",
      "guide": "commands/osk.md",
      "prefer": "mcp",
      "fallback": "cli"
    },
    "approvalRequiredTools": [
      "osk_plan_learning_sources",
      "osk_review_behavior",
      "osk_compile_deploy",
      "osk_pack_behavior"
    ],
    "readOnlyFirstTools": [
      "osk_get_status",
      "osk_detect_environment",
      "osk_get_plugin_attach_status",
      "osk_get_plugin_install_profile",
      "osk_get_task_context",
      "osk_get_docs_help"
    ],
    "attach": {
      "previewCli": "openskill-kit agent attach-plugin --host opencode --dry-run",
      "applyCli": "openskill-kit agent attach-plugin --host opencode --yes",
      "statusCli": "openskill-kit agent plugin-status --json"
    },
    "hostConfig": [
      {
        "host": "opencode",
        "configPath": "opencode.json",
        "configFormat": "opencode-json",
        "supportLevel": "supported",
        "previewCli": "openskill-kit agent attach-plugin --host opencode --dry-run",
        "applyCli": "openskill-kit agent attach-plugin --host opencode --yes",
        "statusCli": "openskill-kit agent plugin-status --json"
      },
      {
        "host": "codex",
        "configPath": ".codex/config.toml",
        "configFormat": "codex-toml",
        "supportLevel": "supported",
        "previewCli": "openskill-kit agent attach-plugin --host codex --dry-run",
        "applyCli": "openskill-kit agent attach-plugin --host codex --yes",
        "statusCli": "openskill-kit agent plugin-status --json"
      },
      {
        "host": "claude-code",
        "configPath": ".mcp.json",
        "configFormat": "mcp-json",
        "supportLevel": "supported",
        "previewCli": "openskill-kit agent attach-plugin --host claude-code --dry-run",
        "applyCli": "openskill-kit agent attach-plugin --host claude-code --yes",
        "statusCli": "openskill-kit agent plugin-status --json"
      },
      {
        "host": "cursor",
        "configPath": ".cursor/mcp.json",
        "configFormat": "mcp-json",
        "supportLevel": "preview",
        "previewCli": "openskill-kit agent attach-plugin --host cursor --dry-run",
        "applyCli": "openskill-kit agent attach-plugin --host cursor --yes",
        "statusCli": "openskill-kit agent plugin-status --json"
      },
      {
        "host": "generic-mcp",
        "configPath": ".mcp.json",
        "configFormat": "mcp-json",
        "supportLevel": "supported",
        "previewCli": "openskill-kit agent attach-plugin --host generic-mcp --dry-run",
        "applyCli": "openskill-kit agent attach-plugin --host generic-mcp --yes",
        "statusCli": "openskill-kit agent plugin-status --json"
      }
    ]
  },
  "commands": {
    "map": "commands/commands.json",
    "guide": "commands/osk.md",
    "routing": "prefer MCP tools when available; otherwise run CLI fallbacks from the project root",
    "items": [
      {
        "command": "/osk init",
        "aliases": [
          "openskill init",
          "bootstrap openskill"
        ],
        "description": "Initialize project-local OSK state and preview harness attach.",
        "mcpTool": "osk_get_status",
        "cli": "openskill-kit init && openskill-kit status",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli",
        "visibility": "public",
        "familyId": "init"
      },
      {
        "command": "/osk status",
        "aliases": [
          "osk status",
          "openskill status"
        ],
        "description": "Show behavior, review, plugin, and harness health.",
        "mcpTool": "osk_get_status",
        "cli": "openskill-kit status",
        "readOnly": true,
        "approvalRequired": false,
        "fallback": "cli",
        "visibility": "public",
        "familyId": "status"
      },
      {
        "command": "/osk task",
        "aliases": [
          "/osk context",
          "/osk finish task",
          "osk task context",
          "osk task finish"
        ],
        "description": "Load task context before work and record safe outcome after work.",
        "mcpTool": "osk_get_task_context",
        "cli": "openskill-kit context --query \"<task>\"",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli",
        "visibility": "public",
        "familyId": "task"
      },
      {
        "command": "/osk learn",
        "aliases": [
          "learn this session",
          "/osk learn from this session"
        ],
        "description": "Plan and run explicit, review-gated learning from selected sources.",
        "mcpTool": "osk_plan_learning_sources",
        "cli": "openskill-kit learn",
        "readOnly": false,
        "approvalRequired": true,
        "fallback": "cli",
        "visibility": "public",
        "familyId": "learn"
      },
      {
        "command": "/osk review",
        "aliases": [
          "/osk review pending behavior",
          "review behavior"
        ],
        "description": "Inspect and approve, reject, lock, or demote candidate behavior.",
        "mcpTool": "osk_review_behavior",
        "cli": "openskill-kit review",
        "readOnly": false,
        "approvalRequired": true,
        "fallback": "cli",
        "visibility": "public",
        "familyId": "review"
      },
      {
        "command": "/osk research",
        "aliases": [
          "/osk openworld source plan",
          "osk ow source plan"
        ],
        "description": "Plan leakage-audited sources and anchors for unfamiliar tasks.",
        "mcpTool": "osk_run_openworld_workflow",
        "cli": "openskill-kit openworld source-plan --task-id <task-id>",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli",
        "visibility": "public",
        "familyId": "research"
      },
      {
        "command": "/osk evolve",
        "aliases": [
          "/osk evolve this skill",
          "evolve skill"
        ],
        "description": "Generate review-only candidate skills from anchored OpenWorld evidence.",
        "mcpTool": "osk_run_openworld_workflow",
        "cli": "openskill-kit openworld refine --task-id <task-id> --suite-id <suite-id> --candidate-id <candidate-id>",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli",
        "visibility": "public",
        "familyId": "evolve"
      },
      {
        "command": "/osk verify",
        "aliases": [
          "/osk openworld verifier quality",
          "/osk openworld run verifier",
          "osk ow verify"
        ],
        "description": "Run integrity, privacy, verifier, and proof-boundary checks.",
        "mcpTool": "osk_verify_behavior",
        "cli": "openskill-kit openworld verifier-quality --task-id <task-id> --suite-id <suite-id>",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli",
        "visibility": "public",
        "familyId": "verify"
      },
      {
        "command": "/osk compile",
        "aliases": [
          "/osk update skills",
          "/osk update AGENTS.md",
          "osk compile"
        ],
        "description": "Compile active reviewed behavior into harness artifacts.",
        "mcpTool": "osk_compile_deploy",
        "cli": "openskill-kit compile --target plugin",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli",
        "visibility": "public",
        "familyId": "compile"
      },
      {
        "command": "/osk deploy",
        "aliases": [
          "/osk attach plugin",
          "osk attach",
          "deploy opencode"
        ],
        "description": "Preview or apply project-local harness attachment with receipts.",
        "mcpTool": "osk_compile_deploy",
        "cli": "openskill-kit agent attach-plugin --host opencode --dry-run",
        "readOnly": false,
        "approvalRequired": true,
        "fallback": "cli",
        "visibility": "public",
        "familyId": "deploy"
      },
      {
        "command": "/osk eval",
        "aliases": [
          "/osk run behavior eval",
          "behavior eval"
        ],
        "description": "Measure OSK behavior through replay or external-agent evals.",
        "mcpTool": "osk_run_eval",
        "cli": "openskill-kit eval",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli",
        "visibility": "public",
        "familyId": "eval"
      },
      {
        "command": "/osk pack",
        "aliases": [
          "/osk sync project behavior pack",
          "sync behavior pack"
        ],
        "description": "Export, verify, diff, sign, or import behavior packs through trust gates.",
        "mcpTool": "osk_pack_behavior",
        "cli": "openskill-kit pack export",
        "readOnly": false,
        "approvalRequired": true,
        "fallback": "cli",
        "visibility": "public",
        "familyId": "pack"
      }
    ],
    "publicFamilyCount": 12
  },
  "privacy": {
    "localFirst": true,
    "requiresExplicitApproval": [
      "global instruction writes",
      "hook installation",
      "interaction imports",
      "behavior pack imports"
    ],
    "neverIncludes": [
      "raw prompts",
      "raw diffs",
      "secrets",
      "user memories",
      "hidden benchmark answers"
    ]
  }
}
