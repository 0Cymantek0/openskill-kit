{
  "schemaVersion": "openskill-kit.agent-plugin.v1",
  "name": "openskill-kit",
  "version": "0.1.0",
  "displayName": "OpenSkillKit",
  "description": "Local-first behavior memory, skill evolution, and MCP bridge for existing coding harnesses.",
  "compatibility": [
    "agent-plugin",
    "mcp-stdio",
    "codex",
    "claude-code",
    "agents-md"
  ],
  "capabilities": [
    "skill-drafting",
    "skill-audit",
    "skill-evaluation",
    "project-behavior-retrieval",
    "local-mcp-tools",
    "explicit-install-receipts",
    "openworld-review-promotion"
  ],
  "skills": [
    {
      "path": "skills/openskill-kit"
    }
  ],
  "mcp": {
    "config": ".mcp.json",
    "server": "openskill-kit-mcp",
    "transport": "stdio"
  },
  "installGuides": {
    "directory": "install-guides",
    "hosts": {
      "codex": "install-guides/codex.md",
      "claude-code": "install-guides/claude-code.md",
      "cursor": "install-guides/cursor.md",
      "generic-mcp": "install-guides/generic-mcp.md"
    }
  },
  "installProfile": {
    "schemaVersion": "openskill-kit.agent-plugin-install-profile.v1",
    "mode": "local-project-plugin",
    "pluginDirectory": "packages/agent-plugin-bundle",
    "firstCall": {
      "mcpTool": "osk_bootstrap_session",
      "cliFallback": "openskill-kit status --json"
    },
    "mcp": {
      "serverName": "openskill-kit",
      "command": "openskill-kit-mcp",
      "transport": "stdio",
      "workingDirectory": ".",
      "requiredEnv": {
        "OPENSKILLKIT_PROJECT_ROOT": "<absolute project root>"
      },
      "configFile": ".mcp.json",
      "descriptors": "mcp/descriptors.json",
      "descriptorHashes": "mcp/descriptor-hashes.json"
    },
    "commandRouting": {
      "map": "commands/commands.json",
      "guide": "commands/osk.md",
      "prefer": "mcp",
      "fallback": "cli"
    },
    "approvalRequiredTools": [
      "osk_import_interaction_source",
      "osk_install_agent_hooks",
      "osk_apply_manifest_install",
      "osk_apply_plugin_attach",
      "osk_openworld_promote_review",
      "osk_export_behavior_pack"
    ],
    "readOnlyFirstTools": [
      "osk_bootstrap_session",
      "osk_detect_environment",
      "osk_get_plugin_attach_status",
      "osk_get_agent_task_context"
    ],
    "attach": {
      "previewCli": "openskill-kit agent attach-plugin --host generic-mcp --dry-run",
      "applyCli": "openskill-kit agent attach-plugin --host generic-mcp --yes",
      "statusCli": "openskill-kit agent plugin-status --json"
    },
    "hostConfig": [
      {
        "host": "codex",
        "configPath": ".mcp.json",
        "supportLevel": "supported"
      },
      {
        "host": "claude-code",
        "configPath": ".mcp.json",
        "supportLevel": "supported"
      },
      {
        "host": "cursor",
        "configPath": ".cursor/mcp.json",
        "supportLevel": "preview"
      },
      {
        "host": "generic-mcp",
        "configPath": ".mcp.json",
        "supportLevel": "supported"
      }
    ]
  },
  "commands": {
    "map": "commands/commands.json",
    "guide": "commands/osk.md",
    "routing": "prefer MCP tools when available; otherwise run CLI fallbacks from the project root",
    "items": [
      {
        "command": "/osk init",
        "aliases": [
          "openskill init",
          "bootstrap openskill"
        ],
        "description": "Initialize or bootstrap project behavior state and report plugin readiness.",
        "mcpTool": "osk_bootstrap_session",
        "cli": "openskill-kit init && openskill-kit status",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk status",
        "aliases": [
          "osk status",
          "openskill status"
        ],
        "description": "Show learned behavior, compiled artifacts, plugin readiness, and next actions.",
        "mcpTool": "osk_bootstrap_session",
        "cli": "openskill-kit status",
        "readOnly": true,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk context",
        "aliases": [
          "osk task context",
          "openskill context"
        ],
        "description": "Return route plan, relevant behavior, plugin health, review state, and next actions for the current coding task.",
        "mcpTool": "osk_get_agent_task_context",
        "cli": "openskill-kit context --query \"<task>\"",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk finish task",
        "aliases": [
          "osk task done",
          "openskill finish task"
        ],
        "description": "Record safe task outcome evidence, run learning, write session summaries, and return review next actions.",
        "mcpTool": "osk_finish_agent_task",
        "cli": "openskill-kit finish-task --summary \"<safe summary>\"",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk import adapters",
        "aliases": [
          "osk adapters",
          "openskill import adapters"
        ],
        "description": "List supported cross-agent import adapters, accepted formats, privacy policy, and adapter status.",
        "mcpTool": "osk_list_interaction_adapters",
        "cli": "openskill-kit interactions adapters",
        "readOnly": true,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk import session",
        "aliases": [
          "osk import transcript",
          "openskill import session"
        ],
        "description": "Preview or import a cross-agent session/export file as redacted local events; applying requires explicit approval.",
        "mcpTool": "osk_import_interaction_source",
        "cli": "openskill-kit interactions import <path>",
        "readOnly": false,
        "approvalRequired": true,
        "fallback": "cli"
      },
      {
        "command": "/osk import review",
        "aliases": [
          "osk import review comments",
          "openskill import review"
        ],
        "description": "Preview or import a local review-comment file as redacted review feedback events; applying requires explicit approval.",
        "mcpTool": "osk_import_interaction_source",
        "cli": "openskill-kit interactions import-review <path>",
        "readOnly": false,
        "approvalRequired": true,
        "fallback": "cli"
      },
      {
        "command": "/osk import terminal",
        "aliases": [
          "osk import terminal history",
          "openskill import terminal"
        ],
        "description": "Preview or import an explicit terminal history file as allowlisted command metadata only; applying requires explicit approval.",
        "mcpTool": "osk_import_interaction_source",
        "cli": "openskill-kit interactions import-terminal <path>",
        "readOnly": false,
        "approvalRequired": true,
        "fallback": "cli"
      },
      {
        "command": "/osk session imports",
        "aliases": [
          "osk imports",
          "openskill imports"
        ],
        "description": "List previous interaction import runs without raw source content.",
        "mcpTool": "osk_list_interaction_imports",
        "cli": "openskill-kit interactions imports",
        "readOnly": true,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk explain import",
        "aliases": [
          "osk import explain",
          "openskill explain import"
        ],
        "description": "Explain one interaction import receipt, privacy state, and learning next actions without reading raw source content.",
        "mcpTool": "osk_explain_interaction_import",
        "cli": "openskill-kit interactions explain <run-id>",
        "readOnly": true,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk interaction pool",
        "aliases": [
          "osk interactions pool",
          "openskill interaction pool"
        ],
        "description": "List normalized cross-agent interaction metadata records without raw source content.",
        "mcpTool": "osk_get_interaction_pool",
        "cli": "openskill-kit interactions pool",
        "readOnly": true,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk git context",
        "aliases": [
          "osk git",
          "openskill git context"
        ],
        "description": "Inspect local branch, changed files, aggregate diff stats, and recent commits without raw diffs or file contents.",
        "mcpTool": "osk_get_git_local_context",
        "cli": "openskill-kit interactions git-context",
        "readOnly": true,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk learn from this session",
        "aliases": [
          "osk learn",
          "learn this session"
        ],
        "description": "Extract candidate preferences from captured local events after user approval for any import source.",
        "mcpTool": "osk_learn_from_session",
        "cli": "openskill-kit learn",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk explain why you learned this",
        "aliases": [
          "osk explain",
          "explain preference"
        ],
        "description": "Explain a learned preference through sanitized evidence cards.",
        "mcpTool": "osk_explain_preference",
        "cli": "openskill-kit explain <preference-id>",
        "readOnly": true,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk review pending behavior",
        "aliases": [
          "osk review",
          "review behavior"
        ],
        "description": "Open the review queue for candidate behavior before activation.",
        "mcpTool": "osk_get_review_queue",
        "cli": "openskill-kit review",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk update skills",
        "aliases": [
          "osk compile skills",
          "update project skills"
        ],
        "description": "Compile project-scoped skills from active behavior.",
        "mcpTool": "osk_compile_behavior_layer",
        "cli": "openskill-kit compile --target agent-skills",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk update AGENTS.md",
        "aliases": [
          "osk update agents",
          "compile project rules"
        ],
        "description": "Preview managed AGENTS/CLAUDE instruction updates.",
        "mcpTool": "osk_compile_behavior_layer",
        "cli": "openskill-kit compile --target project-rules",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk install hooks",
        "aliases": [
          "osk hooks",
          "install openskill hooks"
        ],
        "description": "Preview or install local hooks; requires explicit user approval before enabling execution.",
        "mcpTool": "osk_install_agent_hooks",
        "cli": "openskill-kit hooks install --dry-run",
        "readOnly": false,
        "approvalRequired": true,
        "fallback": "cli"
      },
      {
        "command": "/osk attach plugin",
        "aliases": [
          "osk attach",
          "attach openskill plugin"
        ],
        "description": "Preview host MCP config needed to attach this plugin to an existing coding harness; applying requires explicit approval.",
        "mcpTool": "osk_preview_plugin_attach",
        "cli": "openskill-kit agent attach-plugin --host generic-mcp --dry-run",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk plugin health",
        "aliases": [
          "osk plugin status",
          "openskill plugin health"
        ],
        "description": "Show host attachment health for the compiled plugin, including root binding, invalid JSON, and command conflicts.",
        "mcpTool": "osk_get_plugin_attach_status",
        "cli": "openskill-kit agent plugin-status",
        "readOnly": true,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk run behavior eval",
        "aliases": [
          "osk eval",
          "behavior eval"
        ],
        "description": "Run local behavior replay/evaluation gates and return artifact paths.",
        "mcpTool": "osk_run_behavior_eval",
        "cli": "openskill-kit eval",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk openworld doctor",
        "aliases": [
          "osk ow doctor",
          "openskill openworld doctor"
        ],
        "description": "Show which OpenWorld capabilities are real today and which remain unproven.",
        "mcpTool": "osk_openworld_doctor",
        "cli": "openskill-kit openworld doctor",
        "readOnly": true,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk openworld source plan",
        "aliases": [
          "osk ow source plan",
          "openskill openworld source plan"
        ],
        "description": "Plan leakage-audited local and explicit web source candidates for an OpenWorld task.",
        "mcpTool": "osk_openworld_source_plan",
        "cli": "openskill-kit openworld source-plan --task-id <task-id>",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk openworld build verifier",
        "aliases": [
          "osk ow build verifier",
          "openskill openworld build verifier"
        ],
        "description": "Build a leakage-audited visible/holdout verifier suite from Anchor Cards, preserving manual-review anchors and traceable local file assertions.",
        "mcpTool": "osk_openworld_build_verifier",
        "cli": "openskill-kit openworld build-verifier --task-id <task-id> --anchor-id <anchor-id>",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk openworld verifier quality",
        "aliases": [
          "osk ow verifier quality",
          "openskill openworld verifier quality"
        ],
        "description": "Score a generated OpenWorld verifier suite for traceability, determinism, holdout coverage, source trust, and leakage metadata.",
        "mcpTool": "osk_openworld_verifier_quality",
        "cli": "openskill-kit openworld verifier-quality --task-id <task-id> --suite-id <suite-id>",
        "readOnly": true,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk openworld run verifier",
        "aliases": [
          "osk ow run verifier",
          "openskill openworld run verifier"
        ],
        "description": "Run a generated OpenWorld verifier split through local-process or opt-in Docker sandbox mode and write execution results.",
        "mcpTool": "osk_openworld_run_verifier",
        "cli": "openskill-kit openworld run-verifier --task-id <task-id> --suite-id <suite-id> --split visible",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk openworld refine",
        "aliases": [
          "osk ow refine",
          "openskill openworld refine"
        ],
        "description": "Run bounded visible verifier refinement and final holdout check for a candidate skill.",
        "mcpTool": "osk_openworld_refine",
        "cli": "openskill-kit openworld refine --task-id <task-id> --suite-id <suite-id> --candidate-id <candidate-id>",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk openworld hidden oracle harness",
        "aliases": [
          "osk ow hidden oracle harness",
          "openskill openworld hidden oracle harness"
        ],
        "description": "Write denied-path and benchmark-readiness harness metadata without reading oracle contents or claiming hidden-oracle proof.",
        "mcpTool": "osk_openworld_hidden_oracle_harness",
        "cli": "openskill-kit openworld hidden-oracle-harness --task-id <task-id> --suite-id <suite-id>",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk openworld report",
        "aliases": [
          "osk ow report",
          "openskill openworld report"
        ],
        "description": "Render task evidence, sources, anchors, verifier runs, eval reports, and remaining proof gaps.",
        "mcpTool": "osk_openworld_task_report",
        "cli": "openskill-kit openworld report --task-id <task-id> --write",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk openworld promote review",
        "aliases": [
          "osk ow promote review",
          "openskill openworld promote review"
        ],
        "description": "Create a review-only proposal from a passed OpenWorld run; it never activates behavior directly.",
        "mcpTool": "osk_openworld_promote_review",
        "cli": "openskill-kit openworld promote-review --run-id <run-id> --dry-run",
        "readOnly": false,
        "approvalRequired": true,
        "fallback": "cli"
      },
      {
        "command": "/osk evolve this skill",
        "aliases": [
          "osk evolve",
          "evolve skill"
        ],
        "description": "Draft, verify, and evaluate a reusable skill from local evidence.",
        "cli": "openskill-kit evolve \"<topic>\" --no-llm",
        "readOnly": false,
        "approvalRequired": false,
        "fallback": "cli"
      },
      {
        "command": "/osk sync project behavior pack",
        "aliases": [
          "osk pack",
          "sync behavior pack"
        ],
        "description": "Export or import behavior packs only through review, verification, and trust gates.",
        "mcpTool": "osk_export_behavior_pack",
        "cli": "openskill-kit pack export",
        "readOnly": false,
        "approvalRequired": true,
        "fallback": "cli"
      }
    ]
  },
  "privacy": {
    "localFirst": true,
    "requiresExplicitApproval": [
      "global instruction writes",
      "hook installation",
      "interaction imports",
      "behavior pack imports"
    ],
    "neverIncludes": [
      "raw prompts",
      "raw diffs",
      "secrets",
      "user memories",
      "hidden benchmark answers"
    ]
  }
}
